package com.order
import dev.techplant.drools.model.Order

//生效日期已过：规则生效，加10分
rule "date_effective_past"
    date-effective "01-Jan-2000"
    when
        $order:Order(amout < 100)
    then
        $order.setScore(10);
        System.out.println("成功匹配到规则：生效日期已过");
end

//生效日期未到：规则不生效
rule "date_effective_future"
    date-effective "01-Jan-2099"
    when
        $order:Order(amout < 100)
    then
        $order.setScore(99);
        System.out.println("成功匹配到规则：生效日期未到（不应出现）");
end
